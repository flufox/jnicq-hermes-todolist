{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "server",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["server-src/**/*.ts", "shared/**/*.ts", "cli/**/*.ts"],
  "exclude": ["**/*.test.ts", "node_modules", "src"]
}
