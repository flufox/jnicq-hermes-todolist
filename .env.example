# Non-secret setup values. Copying this file is optional; ./hermes-todo setup writes .env.
HERMES_TODO_VERSION=0.1.0
HERMES_TODO_DOMAIN=todo.example.com
HERMES_TODO_PUBLIC_URL=https://todo.example.com
HERMES_TODO_ACME_EMAIL=admin@example.com
HERMES_TODO_TIMEZONE=UTC
HERMES_TODO_LOCALE=en
HERMES_TODO_HOME_NAME=My Workspace
HERMES_TODO_PROXY_MODE=caddy
COMPOSE_PROFILES=caddy

# Secrets are files under ./secrets and must never be placed here.
